<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvWireguard" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="TvButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="android:background">@drawable/bg_tv_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="TvButton.Primary">
        <item name="android:background">@drawable/bg_tv_button_primary</item>
        <item name="android:textColor">#04140C</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
